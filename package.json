{
  "name": "nightfall-zombies",
  "version": "5.1.0",
  "private": true,
  "scripts": {
    "start": "serve -s . -l $PORT",
    "prepare:mobile": "node scripts/prepare-mobile.mjs",
    "ios:init": "npm run prepare:mobile && npx cap add ios",
    "ios:sync": "npm run prepare:mobile && npx cap sync ios",
    "ios:open": "npm run ios:sync && npx cap open ios",
    "ios:first-run": "bash scripts/ios-first-run.sh"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "serve": "^14.2.4",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0"
  }
}
